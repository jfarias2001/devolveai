<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      A string de conexão fica AQUI, e não no código-fonte.
      Integrated Security=True: usa o login do Windows, então não há usuário nem senha.
      TrustServerCertificate=True: o LocalDB roda na própria máquina com certificado autoassinado.
    -->
    <add name="CadeMeu"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=CadeMeu;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
